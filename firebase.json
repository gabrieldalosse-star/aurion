{
  "firestore": {"rules":"firestore.rules","indexes":"firestore.indexes.json"},
  "hosting": {
    "public":".",
    "ignore":["firebase.json","firestore.rules","firestore.indexes.json","**/.*","**/node_modules/**","tests/**","package*.json","README.md","LEIA-PRIMEIRO.txt","VALIDACAO.md","preview.cjs"],
    "headers":[
      {"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]},
      {"source":"**/*.@(js|mjs|html)","headers":[{"key":"Cache-Control","value":"no-cache"}]}
    ]
  },
  "emulators":{"auth":{"port":9099},"firestore":{"port":8080},"ui":{"enabled":false},"singleProjectMode":true}
}
