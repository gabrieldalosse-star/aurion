rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validPlan(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerUid','schemaVersion','payload','revision','updatedAt'])
        && d.keys().hasOnly(['ownerUid','schemaVersion','payload','revision','updatedAt'])
        && d.ownerUid == uid
        && d.schemaVersion == 1
        && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 700000
        && d.revision is int && d.revision > 0
        && d.updatedAt == request.time;
    }
    match /aurionUsers/{uid}/data/main {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid) && validPlan(uid) && request.resource.data.revision == 1;
      allow update: if owns(uid) && validPlan(uid)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
